# Copy to .env.local (never commit .env.local).
# Real secrets belong only in .env.local or your host's secret store.

# Local admin demo only — unlocks /admin in development. Not production security.
# Both values are required. Production fails closed if either is missing
# (session secret must be at least 16 characters in production).
# Never reuse the login password as ADMIN_SESSION_SECRET.
ADMIN_DEMO_PASSWORD=change-me-locally
ADMIN_SESSION_SECRET=change-me-session-secret-locally
# Optional comma-separated extra origins for admin mutation Origin checks
# (preview URLs / reverse proxies). Same-origin is always allowed.
# ADMIN_ALLOWED_ORIGINS=https://preview.example.com
#
# Login rate limit: in-memory, 10 attempts / 15 minutes / process.
# Does NOT aggregate across serverless isolates or multiple instances.

# Neon Postgres (Phase A scaffolding). Leave unset until you create a Neon Free
# project and the owner approves migrate/seed. Never put real credentials here.
# db:migrate / db:studio / db:seed refuse to run without a real URL (no placeholder).
# DATABASE_URL=
# Optional direct (unpooled) URL for migrations — Neon console may provide both.
# DATABASE_URL_UNPOOLED=
#
# Seed safety (when approved to run):
#   npm run db:seed                  — insert-only; skips existing products/colors/stock qty
#   npm run db:seed -- --force-catalog  — OVERWRITES product + color metadata (owner opt-in)
#   npm run db:seed -- --force-stock    — OVERWRITES stock quantities (owner opt-in)
#   Exact tokens only; unknown --force* flags are rejected.
#   Writes use neon-http db.batch (one HTTP transaction). Interactive TX unsupported.
#   Obsolete colors/size-stock are NEVER auto-deleted — cleanup needs separate approval.
# Offline planner tests (no DB): npm run test:seed-plan

# Phase B catalog cutover flag (B2 storefront integration).
# Keep false by default — storefront uses SEED_PRODUCTS + localStorage.
# When true, listing / PDP / home consume Neon via RSC bootstrap (no seed fallback
# on misconfig or query failure). DATABASE_URL must be a real Neon URL.
# Browser-safe flag helper: src/lib/catalog/catalog-flag.ts (no DB imports).
# URL checks: src/lib/catalog/server-catalog-access.ts (server-only).
# Rollback: set USE_SERVER_CATALOG=false (or unset) and redeploy/restart.
USE_SERVER_CATALOG=false
# Offline catalog tests (no DB): npm run test:catalog-b1
